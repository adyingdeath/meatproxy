{
  "name": "@adyingdeath/meatproxy",
  "version": "1.0.1",
  "description": "MeatProxy is a small bridge between your clipboard and chatbots.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "agent",
    "agent harness"
  ],
  "author": "adyingdeath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adyingdeath/meatproxy.git"
  },
  "homepage": "https://github.com/adyingdeath/meatproxy",
  "bugs": {
    "url": "https://github.com/adyingdeath/meatproxy/issues"
  },
  "type": "module",
  "bin": {
    "mtp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
